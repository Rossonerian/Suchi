# URL of your deployed Render backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Set both values only after creating a Clerk application. The backend also
# requires AUTH_PROVIDER=clerk, CLERK_PUBLISHABLE_KEY, and CLERK_SECRET_KEY
# before /api/v1 is enabled.
NEXT_PUBLIC_AUTH_PROVIDER=legacy
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
