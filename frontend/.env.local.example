# Suchi Web Environment Template (Placeholders only)

# Staging/Production: Next.js server rewrite destination (e.g. Railway backend)
# Set in Vercel project environment variables (NOT public, no NEXT_PUBLIC_ prefix)
BACKEND_ORIGIN=https://api.suchi.example.com

# Local development: optional explicit backend URL override
# If unset, local browser requests default to relative same-origin /api via Next.js proxy
# NEXT_PUBLIC_API_URL=http://localhost:5000
