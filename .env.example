# Suchi Universal Platform Environment Template (Placeholders only; NEVER commit secrets)

# Managed PostgreSQL Foundation
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>:5432/<database>?sslmode=require
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<direct-host>:5432/<database>?sslmode=require

# Better Auth Configuration (Option B)
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-cryptographic-secret
BETTER_AUTH_URL=https://api.suchi.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://app.suchi.example.com,suchi://

# CORS & Routing
CORS_ORIGIN=https://app.suchi.example.com
FRONTEND_URL=https://app.suchi.example.com

# Integrations Security
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_STATE_SECRET=

# Feature Toggles & Integrations
GOOGLE_CALENDAR_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.suchi.example.com/api/v1/integrations/google/calendar/callback
BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_ENABLED=0
OPENROUTER_API_KEY=
AI_CONFIRMATION_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
