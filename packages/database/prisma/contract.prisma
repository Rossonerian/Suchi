// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Organization {
    id                       String                    @id(map: "Organization_pkey")
    legacyExternalId         String?
    name                     String
    slug                     String
    createdAt                Timestamp(3)              @default(now())
    updatedAt                Timestamp(3)
    logo                     String?
    metadata                 String?
    activityEvents           ActivityEvent[]
    aiConversations          AiConversation[]
    aiUsageRecords           AiUsageRecord[]
    attachments              Attachment[]
    auditLogs                AuditLog[]
    comments                 Comment[]
    externalResourceMappings ExternalResourceMapping[]
    integrationConnections   IntegrationConnection[]
    labels                   Label[]
    meetings                 Meeting[]
    notifications            Notification[]
    organizationInvitations  OrganizationInvitation[]
    organizationMemberships  OrganizationMembership[]
    organizationSettings     OrganizationSettings?
    projects                 Project[]
    subscription             Subscription?
    tasks                    Task[]
    teams                    Team[]
    usageCounters            UsageCounter[]

    @@index([legacyExternalId], map: "Organization_legacyExternalId_key", unique: true)
    @@index([slug], map: "Organization_slug_key", unique: true)
    @@map("Organization")
  }

  model AuthUser {
    id            String        @id(map: "AuthUser_pkey")
    name          String
    email         String
    emailVerified Boolean       @default(false)
    image         String?
    createdAt     Timestamp(3)  @default(now())
    updatedAt     Timestamp(3)
    authAccounts  AuthAccount[]
    authSessions  AuthSession[]
    userProfile   UserProfile?

    @@index([email], map: "AuthUser_email_key", unique: true)
    @@map("AuthUser")
  }

  model UserProfile {
    id                      String                   @id(map: "UserProfile_pkey")
    legacyExternalId        String?
    displayName             String
    email                   String
    avatarUrl               String?
    createdAt               Timestamp(3)             @default(now())
    updatedAt               Timestamp(3)
    emailVerified           Boolean                  @default(false)
    authUserId              String?                  @unique(map: "UserProfile_authUserId_key")
    activityEvents          ActivityEvent[]
    auditLogs               AuditLog[]
    comments                Comment[]
    organizationInvitations OrganizationInvitation[]
    organizationMemberships OrganizationMembership[]
    projects                Project[]
    tasks                   Task[]
    teamMembers             TeamMember[]
    authUser                AuthUser?                @relation(fields: [authUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "UserProfile_authUserId_fkey")
    @@index([email], map: "UserProfile_email_key", unique: true)
    @@index([legacyExternalId], map: "UserProfile_legacyExternalId_key", unique: true)
    @@map("UserProfile")
  }

  model ActivityEvent {
    id             String       @id(map: "ActivityEvent_pkey")
    organizationId String
    actorId        String?
    action         String
    resourceType   String
    resourceId     String
    metadata       Jsonb?
    createdAt      Timestamp(3) @default(now())
    actor          UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "ActivityEvent_actorId_fkey", index: false)
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ActivityEvent_organizationId_fkey", index: false)

    @@index([organizationId, resourceType, resourceId, createdAt], map: "ActivityEvent_organizationId_resourceType_resourceId_create_idx")
    @@map("ActivityEvent")
  }

  model AiConversation {
    id             String       @id(map: "AiConversation_pkey")
    organizationId String
    userId         String
    title          String?
    createdAt      Timestamp(3) @default(now())
    updatedAt      Timestamp(3)
    aiMessages     AiMessage[]
    aiRuns         AiRun[]
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AiConversation_organizationId_fkey", index: false)

    @@index([organizationId, userId, updatedAt], map: "AiConversation_organizationId_userId_updatedAt_idx")
    @@map("AiConversation")
  }

  model AiMessage {
    id             String         @id(map: "AiMessage_pkey")
    conversationId String
    role           String
    content        String
    createdAt      Timestamp(3)   @default(now())
    conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AiMessage_conversationId_fkey", index: false)
    @@map("AiMessage")
  }

  model AiRun {
    id                String         @id(map: "AiRun_pkey")
    conversationId    String
    capability        String
    _model            String         @map("model")
    status            String
    latencyMs         Int?
    createdAt         Timestamp(3)   @default(now())
    confirmationNonce String?
    confirmedAt       Timestamp(3)?
    aiUsageRecord     AiUsageRecord?
    conversation      AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AiRun_conversationId_fkey", index: false)

    @@index([confirmationNonce], map: "AiRun_confirmationNonce_key", unique: true)
    @@map("AiRun")
  }

  model AiUsageRecord {
    id             String          @id(map: "AiUsageRecord_pkey")
    runId          String          @unique(map: "AiUsageRecord_runId_key")
    organizationId String
    inputTokens    Int?
    outputTokens   Int?
    estimatedCost  Numeric(12, 6)?
    organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AiUsageRecord_organizationId_fkey")
    run            AiRun           @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AiUsageRecord_runId_fkey")

    @@index([organizationId], map: "AiUsageRecord_organizationId_idx")
    @@map("AiUsageRecord")
  }

  model Team {
    id             String       @id(map: "Team_pkey")
    organizationId String
    name           String
    slug           String?
    createdAt      Timestamp(3) @default(now())
    memberCount    Int          @default(0)
    updatedAt      Timestamp(3)
    projects       Project[]
    teamMembers    TeamMember[]
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Team_organizationId_fkey")

    @@index([organizationId], map: "Team_organizationId_idx")
    @@index([organizationId, slug], map: "Team_organizationId_slug_key", unique: true)
    @@map("Team")
  }

  model Project {
    id             String          @id(map: "Project_pkey")
    organizationId String
    teamId         String?
    name           String
    slug           String
    description    String          @default("")
    status         String          @default("active")
    ownerId        String
    startDate      Timestamp(3)?
    targetDate     Timestamp(3)?
    archivedAt     Timestamp(3)?
    createdAt      Timestamp(3)    @default(now())
    updatedAt      Timestamp(3)
    meetings       Meeting[]
    milestones     Milestone[]
    projectMembers ProjectMember[]
    tasks          Task[]
    organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Project_organizationId_fkey", index: false)
    owner          UserProfile     @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Project_ownerId_fkey", index: false)
    team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Project_teamId_fkey", index: false)

    @@index([organizationId, slug], map: "Project_organizationId_slug_key", unique: true)
    @@index([organizationId, status], map: "Project_organizationId_status_idx")
    @@index([organizationId, targetDate], map: "Project_organizationId_targetDate_idx")
    @@map("Project")
  }

  model Milestone {
    id          String        @id(map: "Milestone_pkey")
    projectId   String
    name        String
    description String        @default("")
    targetDate  Timestamp(3)?
    completedAt Timestamp(3)?
    tasks       Task[]
    project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Milestone_projectId_fkey", index: false)

    @@index([projectId, targetDate], map: "Milestone_projectId_targetDate_idx")
    @@map("Milestone")
  }

  model Task {
    id                             String                @id(map: "Task_pkey")
    organizationId                 String
    projectId                      String
    milestoneId                    String?
    creatorId                      String
    title                          String
    description                    String                @default("")
    status                         pg.enum(TaskStatus)   @default("todo")
    priority                       pg.enum(TaskPriority) @default("none")
    startAt                        Timestamp(3)?
    dueAt                          Timestamp(3)?
    completedAt                    Timestamp(3)?
    recurringRule                  String?
    createdAt                      Timestamp(3)          @default(now())
    updatedAt                      Timestamp(3)
    attachments                    Attachment[]
    comments                       Comment[]
    subtasks                       Subtask[]
    taskAssignees                  TaskAssignee[]
    taskLabels                     TaskLabel[]
    creator                        UserProfile           @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Task_creatorId_fkey", index: false)
    milestone                      Milestone?            @relation(fields: [milestoneId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Task_milestoneId_fkey", index: false)
    organization                   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Task_organizationId_fkey", index: false)
    project                        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Task_projectId_fkey", index: false)
    taskDependencies               TaskDependency[]      @relation(name: "TaskDependency_dependencyId_fkey")
    taskDependenciesTaskDependency TaskDependency[]      @relation(name: "TaskDependency_taskId_fkey")

    @@index([organizationId, creatorId], map: "Task_organizationId_creatorId_idx")
    @@index([organizationId, projectId], map: "Task_organizationId_projectId_idx")
    @@index([organizationId, status, dueAt], map: "Task_organizationId_status_dueAt_idx")
    @@map("Task")
  }

  model Attachment {
    id             String        @id(map: "Attachment_pkey")
    organizationId String
    taskId         String?
    objectKey      String
    fileName       String
    contentType    String
    byteSize       Int
    createdAt      Timestamp(3)  @default(now())
    status         String        @default("pending")
    uploadedAt     Timestamp(3)?
    organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Attachment_organizationId_fkey", index: false)
    task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Attachment_taskId_fkey", index: false)

    @@index([organizationId, taskId], map: "Attachment_organizationId_taskId_idx")
    @@map("Attachment")
  }

  model AuditLog {
    id             String       @id(map: "AuditLog_pkey")
    organizationId String
    actorId        String?
    action         String
    resourceType   String
    resourceId     String?
    source         String
    metadata       Jsonb?
    createdAt      Timestamp(3) @default(now())
    actor          UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "AuditLog_actorId_fkey", index: false)
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AuditLog_organizationId_fkey", index: false)

    @@index([organizationId, createdAt], map: "AuditLog_organizationId_createdAt_idx")
    @@map("AuditLog")
  }

  model AuthAccount {
    id                    String        @id(map: "AuthAccount_pkey")
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  Timestamp(3)?
    refreshTokenExpiresAt Timestamp(3)?
    scope                 String?
    password              String?
    createdAt             Timestamp(3)  @default(now())
    updatedAt             Timestamp(3)
    user                  AuthUser      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AuthAccount_userId_fkey")

    @@index([providerId, accountId], map: "AuthAccount_providerId_accountId_key", unique: true)
    @@index([userId], map: "AuthAccount_userId_idx")
    @@map("AuthAccount")
  }

  model AuthSession {
    id                   String       @id(map: "AuthSession_pkey")
    expiresAt            Timestamp(3)
    token                String
    createdAt            Timestamp(3) @default(now())
    updatedAt            Timestamp(3)
    ipAddress            String?
    userAgent            String?
    userId               String
    activeOrganizationId String?
    activeTeamId         String?
    user                 AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AuthSession_userId_fkey")

    @@index([token], map: "AuthSession_token_key", unique: true)
    @@index([userId], map: "AuthSession_userId_idx")
    @@map("AuthSession")
  }

  model AuthVerification {
    id         String       @id(map: "AuthVerification_pkey")
    identifier String
    value      String
    expiresAt  Timestamp(3)
    createdAt  Timestamp(3) @default(now())
    updatedAt  Timestamp(3)

    @@index([identifier], map: "AuthVerification_identifier_idx")
    @@map("AuthVerification")
  }

  model BillingWebhookEvent {
    id          String        @id(map: "BillingWebhookEvent_pkey")
    provider    String
    eventId     String
    receivedAt  Timestamp(3)  @default(now())
    processedAt Timestamp(3)?

    @@index([provider, eventId], map: "BillingWebhookEvent_provider_eventId_key", unique: true)
    @@map("BillingWebhookEvent")
  }

  model Comment {
    id             String       @id(map: "Comment_pkey")
    organizationId String
    taskId         String?
    authorId       String
    body           String
    createdAt      Timestamp(3) @default(now())
    updatedAt      Timestamp(3)
    author         UserProfile  @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Comment_authorId_fkey", index: false)
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Comment_organizationId_fkey", index: false)
    task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Comment_taskId_fkey", index: false)

    @@index([organizationId, taskId, createdAt], map: "Comment_organizationId_taskId_createdAt_idx")
    @@map("Comment")
  }

  model ExternalResourceMapping {
    id             String       @id(map: "ExternalResourceMapping_pkey")
    organizationId String
    provider       String
    resourceType   String
    localId        String
    externalId     String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ExternalResourceMapping_organizationId_fkey", index: false)

    @@index([organizationId, resourceType, localId, provider], map: "ExternalResourceMapping_organizationId_resourceType_localId_key", unique: true)
    @@index([provider, resourceType, externalId], map: "ExternalResourceMapping_provider_resourceType_externalId_key", unique: true)
    @@map("ExternalResourceMapping")
  }

  model IntegrationConnection {
    id                       String                    @id(map: "IntegrationConnection_pkey")
    organizationId           String
    provider                 String
    status                   String                    @default("connected")
    encryptedToken           String
    createdAt                Timestamp(3)              @default(now())
    updatedAt                Timestamp(3)
    integrationAccounts      IntegrationAccount[]
    integrationWebhookEvents IntegrationWebhookEvent[]
    organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "IntegrationConnection_organizationId_fkey", index: false)

    @@index([organizationId, provider], map: "IntegrationConnection_organizationId_provider_key", unique: true)
    @@map("IntegrationConnection")
  }

  model IntegrationAccount {
    id           String                @id(map: "IntegrationAccount_pkey")
    connectionId String
    externalId   String
    displayName  String
    connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "IntegrationAccount_connectionId_fkey", index: false)

    @@index([connectionId, externalId], map: "IntegrationAccount_connectionId_externalId_key", unique: true)
    @@map("IntegrationAccount")
  }

  model IntegrationWebhookEvent {
    id           String                @id(map: "IntegrationWebhookEvent_pkey")
    connectionId String
    provider     String
    eventId      String
    receivedAt   Timestamp(3)          @default(now())
    processedAt  Timestamp(3)?
    connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "IntegrationWebhookEvent_connectionId_fkey", index: false)

    @@index([provider, eventId], map: "IntegrationWebhookEvent_provider_eventId_key", unique: true)
    @@map("IntegrationWebhookEvent")
  }

  model Label {
    id             String       @id(map: "Label_pkey")
    organizationId String
    name           String
    color          String
    taskLabels     TaskLabel[]
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Label_organizationId_fkey", index: false)

    @@index([organizationId, name], map: "Label_organizationId_name_key", unique: true)
    @@map("Label")
  }

  model Meeting {
    id                      String                   @id(map: "Meeting_pkey")
    organizationId          String
    projectId               String?
    creatorId               String
    title                   String
    description             String                   @default("")
    startAt                 Timestamp(3)
    endAt                   Timestamp(3)
    timezone                String
    location                String                   @default("")
    videoUrl                String                   @default("")
    provider                String?
    externalEventId         String?
    createdAt               Timestamp(3)             @default(now())
    updatedAt               Timestamp(3)
    cancelledAt             Timestamp(3)?
    status                  String                   @default("scheduled")
    meetingAttendees        MeetingAttendee[]
    meetingExternalMappings MeetingExternalMapping[]
    organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Meeting_organizationId_fkey", index: false)
    project                 Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Meeting_projectId_fkey", index: false)

    @@index([organizationId, provider, externalEventId], map: "Meeting_organizationId_provider_externalEventId_key", unique: true)
    @@index([organizationId, startAt], map: "Meeting_organizationId_startAt_idx")
    @@map("Meeting")
  }

  model OrganizationMembership {
    id               String                    @id(map: "OrganizationMembership_pkey")
    organizationId   String
    userId           String
    role             pg.enum(OrganizationRole) @default("member")
    createdAt        Timestamp(3)              @default(now())
    meetingAttendees MeetingAttendee[]
    projectMembers   ProjectMember[]
    taskAssignees    TaskAssignee[]
    teamMembers      TeamMember[]
    organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrganizationMembership_organizationId_fkey", index: false)
    user             UserProfile               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrganizationMembership_userId_fkey", index: false)

    @@index([organizationId, role], map: "OrganizationMembership_organizationId_role_idx")
    @@index([organizationId, userId], map: "OrganizationMembership_organizationId_userId_key", unique: true)
    @@map("OrganizationMembership")
  }

  model MeetingAttendee {
    id           String                  @id(map: "MeetingAttendee_pkey")
    meetingId    String
    membershipId String?
    email        String
    meeting      Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MeetingAttendee_meetingId_fkey")
    membership   OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MeetingAttendee_membershipId_fkey", index: false)

    @@index([meetingId], map: "MeetingAttendee_meetingId_idx")
    @@map("MeetingAttendee")
  }

  model MeetingExternalMapping {
    id                 String  @id(map: "MeetingExternalMapping_pkey")
    meetingId          String
    provider           String
    externalEventId    String
    externalCalendarId String?
    syncVersion        String?
    meeting            Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MeetingExternalMapping_meetingId_fkey", index: false)

    @@index([provider, externalEventId], map: "MeetingExternalMapping_provider_externalEventId_key", unique: true)
    @@map("MeetingExternalMapping")
  }

  model Notification {
    id             String        @id(map: "Notification_pkey")
    organizationId String
    userId         String
    _type          String        @map("type")
    title          String
    body           String
    resourceType   String?
    resourceId     String?
    readAt         Timestamp(3)?
    createdAt      Timestamp(3)  @default(now())
    dedupeKey      String?
    organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Notification_organizationId_fkey", index: false)

    @@index([dedupeKey], map: "Notification_dedupeKey_key", unique: true)
    @@index([organizationId, userId, readAt, createdAt], map: "Notification_organizationId_userId_readAt_createdAt_idx")
    @@map("Notification")
  }

  model NotificationPreference {
    id        String  @id(map: "NotificationPreference_pkey")
    userId    String
    channel   String
    eventType String
    enabled   Boolean @default(true)

    @@index([userId, channel, eventType], map: "NotificationPreference_userId_channel_eventType_key", unique: true)
    @@map("NotificationPreference")
  }

  model OrganizationInvitation {
    id             String       @id(map: "OrganizationInvitation_pkey")
    organizationId String
    email          String
    role           String?
    teamId         String?
    status         String       @default("pending")
    expiresAt      Timestamp(3)
    createdAt      Timestamp(3) @default(now())
    inviterId      String
    inviter        UserProfile  @relation(fields: [inviterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrganizationInvitation_inviterId_fkey", index: false)
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrganizationInvitation_organizationId_fkey")

    @@index([email], map: "OrganizationInvitation_email_idx")
    @@index([organizationId], map: "OrganizationInvitation_organizationId_idx")
    @@map("OrganizationInvitation")
  }

  model OrganizationSettings {
    id             String       @id(map: "OrganizationSettings_pkey")
    organizationId String       @unique(map: "OrganizationSettings_organizationId_key")
    timezone       String       @default("UTC")
    weekStartsOn   Int          @default(1)
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrganizationSettings_organizationId_fkey")
    @@map("OrganizationSettings")
  }

  model ProjectMember {
    id           String                 @id(map: "ProjectMember_pkey")
    projectId    String
    membershipId String
    role         pg.enum(ProjectRole)   @default("member")
    membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProjectMember_membershipId_fkey", index: false)
    project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProjectMember_projectId_fkey", index: false)

    @@index([projectId, membershipId], map: "ProjectMember_projectId_membershipId_key", unique: true)
    @@map("ProjectMember")
  }

  model Subscription {
    id                       String                    @id(map: "Subscription_pkey")
    organizationId           String                    @unique(map: "Subscription_organizationId_key")
    provider                 String                    @default("stripe")
    externalId               String?                   @unique(map: "Subscription_externalId_key")
    status                   String
    planKey                  String
    currentPeriodEnd         Timestamp(3)?
    subscriptionEntitlements SubscriptionEntitlement[]
    organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Subscription_organizationId_fkey")
    @@map("Subscription")
  }

  model SubscriptionEntitlement {
    id             String       @id(map: "SubscriptionEntitlement_pkey")
    subscriptionId String
    key            String
    value          String
    subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SubscriptionEntitlement_subscriptionId_fkey", index: false)

    @@index([subscriptionId, key], map: "SubscriptionEntitlement_subscriptionId_key_key", unique: true)
    @@map("SubscriptionEntitlement")
  }

  model Subtask {
    id          String        @id(map: "Subtask_pkey")
    taskId      String
    title       String
    completedAt Timestamp(3)?
    task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Subtask_taskId_fkey", index: false)
    @@map("Subtask")
  }

  model TaskAssignee {
    id           String                 @id(map: "TaskAssignee_pkey")
    taskId       String
    membershipId String
    membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskAssignee_membershipId_fkey")
    task         Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskAssignee_taskId_fkey", index: false)

    @@index([membershipId], map: "TaskAssignee_membershipId_idx")
    @@index([taskId, membershipId], map: "TaskAssignee_taskId_membershipId_key", unique: true)
    @@map("TaskAssignee")
  }

  model TaskDependency {
    id           String @id(map: "TaskDependency_pkey")
    taskId       String
    dependencyId String
    dependency   Task   @relation(name: "TaskDependency_dependencyId_fkey", fields: [dependencyId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskDependency_dependencyId_fkey", index: false)
    task         Task   @relation(name: "TaskDependency_taskId_fkey", fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskDependency_taskId_fkey", index: false)

    @@index([taskId, dependencyId], map: "TaskDependency_taskId_dependencyId_key", unique: true)
    @@map("TaskDependency")
  }

  model TaskLabel {
    taskId  String
    labelId String
    label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskLabel_labelId_fkey", index: false)
    task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TaskLabel_taskId_fkey", index: false)

    @@id([taskId, labelId], map: "TaskLabel_pkey")
    @@map("TaskLabel")
  }

  model TeamMember {
    id            String                  @id(map: "TeamMember_pkey")
    teamId        String
    membershipId  String?
    createdAt     Timestamp(3)            @default(now())
    membershipKey String?
    userId        String
    membership    OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TeamMember_membershipId_fkey", index: false)
    team          Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TeamMember_teamId_fkey", index: false)
    user          UserProfile             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TeamMember_userId_fkey", index: false)

    @@index([membershipKey], map: "TeamMember_membershipKey_key", unique: true)
    @@index([teamId, membershipId], map: "TeamMember_teamId_membershipId_key", unique: true)
    @@index([teamId, userId], map: "TeamMember_teamId_userId_key", unique: true)
    @@map("TeamMember")
  }

  model UsageCounter {
    id             String       @id(map: "UsageCounter_pkey")
    organizationId String
    key            String
    periodStart    Timestamp(3)
    quantity       Int          @default(0)
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UsageCounter_organizationId_fkey", index: false)

    @@index([organizationId, key, periodStart], map: "UsageCounter_organizationId_key_periodStart_key", unique: true)
    @@map("UsageCounter")
  }

  native_enum OrganizationRole {
    owner = "owner"
    admin = "admin"
    member = "member"
  }

  native_enum ProjectRole {
    owner = "owner"
    manager = "manager"
    member = "member"
    viewer = "viewer"
  }

  native_enum TaskPriority {
    none = "none"
    low = "low"
    medium = "medium"
    high = "high"
    urgent = "urgent"
  }

  native_enum TaskStatus {
    backlog = "backlog"
    todo = "todo"
    in_progress = "in_progress"
    blocked = "blocked"
    review = "review"
    done = "done"
    cancelled = "cancelled"
  }

  model PrismaMigrations {
    id                VarChar(36)  @id(map: "_prisma_migrations_pkey")
    checksum          VarChar(64)
    finishedAt        Timestamptz? @map("finished_at")
    migrationName     VarChar(255) @map("migration_name")
    logs              String?
    rolledBackAt      Timestamptz? @map("rolled_back_at")
    startedAt         Timestamptz  @default(now()) @map("started_at")
    appliedStepsCount Int          @default(0) @map("applied_steps_count")

    @@map("_prisma_migrations")
  }

}
