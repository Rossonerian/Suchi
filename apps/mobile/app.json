{
  "expo": {
    "name": "Suchi",
    "slug": "suchi",
    "scheme": "suchi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suchi.workspace"
    },
    "android": {
      "package": "com.suchi.workspace"
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
