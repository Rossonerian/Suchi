{
  "name": "suchi-backend",
  "version": "1.0.0",
  "description": "Backend API for the Suchi workspace platform",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run db:generate",
    "start": "node saas/server.js",
    "dev": "node --watch saas/server.js",
    "start:legacy": "node server.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "migrate:saas": "node scripts/migrate-nidar-to-saas.js",
    "create-admin": "node scripts/create-admin.js",
    "seed:runtime": "node scripts/seed-saas-runtime.js",
    "db:migrate:deploy": "prisma migrate deploy --schema=../packages/database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema=../packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../packages/database/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema=../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/expo": "^1.7.3",
    "@better-auth/prisma-adapter": "^1.7.3",
    "@clerk/express": "^2.1.66",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "inngest": "^4.20.0",
    "mongoose": "^8.5.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
