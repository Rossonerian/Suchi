# Suchi SaaS Backend Environment Template (Placeholders only; NEVER commit secrets)

# Server & Runtime
NODE_ENV=production
PORT=5000
TRUST_PROXY=1

# Managed PostgreSQL (Neon, Supabase, Prisma Postgres, AWS RDS)
# Pooled connection string used by the runtime application
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>:5432/<database>?sslmode=require
# Direct connection string used for migrations (bypasses transaction poolers like pgbouncer)
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<direct-host>:5432/<database>?sslmode=require

# Database Connection Pool Configuration
PGMAXCONNECTIONS=20
PGCONNECT_TIMEOUT_MS=5000
PGIDLE_TIMEOUT_MS=30000

# Better Auth Configuration (Option B)
# Secret must be at least 32 characters high-entropy random string (e.g. openssl rand -hex 32)
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-cryptographic-secret
# Public URL of the backend API (must use HTTPS in production)
BETTER_AUTH_URL=https://api.suchi.example.com
# Allowed frontend origins and native schemes (comma-separated, NO wildcards in production)
BETTER_AUTH_TRUSTED_ORIGINS=https://app.suchi.example.com,suchi://

# CORS & Frontend URLs
CORS_ORIGIN=https://app.suchi.example.com
FRONTEND_URL=https://app.suchi.example.com

# Integrations & Encryption (Required if integrations are enabled)
# 32-byte hex encryption key for sensitive tokens (e.g. openssl rand -hex 32)
INTEGRATION_ENCRYPTION_KEY=
# Random secret for signing OAuth state parameters
INTEGRATION_STATE_SECRET=

# Optional: Google Calendar Integration
GOOGLE_CALENDAR_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Better Auth OAuth is unavailable unless both Google values are configured.
# These are backend/Railway secrets; never expose GOOGLE_CLIENT_SECRET to the frontend.
GOOGLE_REDIRECT_URI=https://api.suchi.example.com/api/v1/integrations/google/calendar/callback

# Optional: Stripe Billing Integration
BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: AI Assistant (OpenRouter)
AI_ENABLED=0
OPENROUTER_API_KEY=
AI_CONFIRMATION_SECRET=

# Optional: S3 Attachment Storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: Inngest Background Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: Email Delivery (Resend or Gmail SMTP)
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
