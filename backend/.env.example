# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Port Render will inject PORT automatically, this is only used for local dev
PORT=5000
# Render production deployment should set NODE_ENV=production

# Comma-separated list of allowed frontend origins (your Vercel URL + localhost)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=0

# Session cookie configuration (use none + HTTPS for a separately hosted API)
SESSION_TTL_HOURS=168
SESSION_SAME_SITE=lax

# Gmail address used to send meeting-invite emails
GMAIL_USER=<gmail-address>

# Gmail App Password (NOT your normal Gmail password) — create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
GMAIL_APP_PASSWORD=<gmail-app-password>

# SaaS/Clerk development values. Leave AUTH_PROVIDER=legacy until a Clerk
# development instance is configured; the Clerk middleware requires both keys.
AUTH_PROVIDER=legacy
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
